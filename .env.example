# ---------------------------------------------------------------------------
# FluencyBridge Inspector — environment template
# Copy to .env  ->  cp .env.example .env  and fill in your keys.
# Every key is OPTIONAL: with no keys the server runs in clearly-labelled
# MOCK mode so the UI + research pipeline can be demoed for $0.
# ---------------------------------------------------------------------------

# ---- Microsoft Azure Cognitive Services (Speech) --------------------------
# Azure Portal -> "Speech services" resource -> Keys and Endpoint
AZURE_SPEECH_KEY=
# e.g. eastus, westus2, japaneast, southeastasia
AZURE_SPEECH_REGION=eastus

# Optional: recognition language and phoneme alphabet for the inspector
AZURE_SPEECH_LANGUAGE=en-US
AZURE_PHONEME_ALPHABET=IPA

# Optional: override the Azure neural TTS voice used by the "Azure Neural TTS"
# toggle in the UI (rate is pinned to ~0.85 via SSML prosody).
# The student UI offers en-US-JennyNeural (female) and en-US-GuyNeural (male).
AZURE_TTS_VOICE=en-US-JennyNeural

# ---- DeepSeek --------------------------------------------------------------
DEEPSEEK_API_KEY=
# deepseek-chat (V3.x/V4.x chat, supports JSON mode) or deepseek-flash if your
# account exposes it. Anything OpenAI-compatible works here.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# 0..2 — kept modest so recasts stay close to the student's meaning
DEEPSEEK_TEMPERATURE=0.6

# ---- Server ----------------------------------------------------------------
PORT=3000
# Hard cap for a single recording (browser also auto-stops at 30 s)
MAX_AUDIO_MB=24
# Force mock providers even when keys exist (useful for A/B comparison runs)
FORCE_MOCK=false

# ---- Deployment hardening (all optional) -----------------------------------
# Shared passcode for a public deployment. When set, every /api route except
# /api/health and /api/session needs either an `X-Access-Code: <code>` header
# or the HttpOnly cookie issued by POST /api/session. The browser UI shows a
# passcode dialog automatically. Leave empty to run the lab open.
ACCESS_CODE=
# Session cookie lifetime (ms). Default 12 hours.
ACCESS_CODE_TTL_MS=43200000
# Passcode attempts allowed per IP per 15 minutes (brute-force guard).
ACCESS_ATTEMPT_LIMIT=10
# Force the `Secure` cookie flag when TLS terminates before Node. Left false,
# the flag is added automatically for https requests.
SECURE_COOKIES=false

# Rate limit per client IP for the paid provider routes (default 30 / 60 s).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Every word/phoneme playback tap is one /api/tts call, so this is separate.
RATE_LIMIT_TTS_MAX=30
# Reverse-proxy hops to trust so limits key on the real client IP.
# nginx/Caddy/Cloudflare in front of Node -> 1. Empty = Node is exposed directly.
TRUST_PROXY=

# ---- Daily usage quotas ----------------------------------------------------
# Practice calls per student (assess + tts + chat) per UTC day. 0 = paused.
USER_DAILY_CALL_LIMIT=60
# Site-wide outbound Azure calls (assessment + TTS) per UTC day. 0 = paused.
DAILY_AZURE_CALL_LIMIT=1500
# Counter storage: leave empty to use Netlify Blobs when available (in-memory
# otherwise). `memory` forces the local fallback (used by the test suite).
USAGE_STORE=
USAGE_STORE_NAME=fluencybridge-usage
# Credentials for Netlify Blobs when running outside Netlify (CI/dev).
# Inside a Netlify Function the context is injected automatically.
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# ---- Audio guards ----------------------------------------------------------
# Digital-silence floors for the server pre-check. Keep these far below soft
# speech (a tentative utterance peaks around 0.002-0.02) so quiet, L1-accented
# recordings are never discarded. Set both to 0 to disable the pre-check.
SILENCE_PEAK_THRESHOLD=0.001
SILENCE_RMS_THRESHOLD=0.0002
